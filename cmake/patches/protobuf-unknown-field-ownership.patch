+namespace {
+std::string* CreateStringForArena(Arena* arena) {
+  static_assert(noexcept(std::string()),
+                "Arena string default construction must not throw");
+  return Arena::Create<std::string>(arena);
+}
+
+std::string* CreateStringForArena(Arena* arena, const std::string& value) {
+  if (arena == nullptr) return new std::string(value);
+  // Arena::Create registers cleanup before its constructor. Construct a
+  // nonthrowing empty object first, then copy through a temporary whose
+  // failed constructor cannot leave an arena cleanup for an invalid string.
+  // Moving preserves the successful copy constructor's exact buffer capacity.
+  std::string* result = CreateStringForArena(arena);
+  *result = std::string(value);
+  return result;
+}
